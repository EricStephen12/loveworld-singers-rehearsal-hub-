rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===== ADMIN USERS (for make admin/unadmin functionality) =====
    match /admin_users/{adminId} {
      allow read: if true;  // Open for admin panel
      allow write: if true;  // Open for admin panel to manage admins
    }

    // ===== KINGSCHAT AUTH SESSIONS (for OAuth flow) =====
    match /kingschat_auth_sessions/{sessionId} {
      allow read, write: if true;  // Allow reading/writing auth sessions
    }

    // ===== PROFILES COLLECTION =====
    match /profiles/{profileId} {
      allow read, list: if true;  // Allow reading and listing profiles
      allow create: if true;  // Allow creating new profiles
      allow update: if true;  // Allow updating profiles
      allow delete: if true;  // Allow deleting profiles (needed for temp account cleanup during migration)
    }
    
    // ===== EXPLICIT QUERY PERMISSIONS =====
    match /profiles/{document=**} {
      allow read, list: if true;  // Allow querying profiles collection
    }

    // ===== OTHER COLLECTIONS (add as needed) =====
    match /{document=**} {
      allow read, write: if true;  // Temporary open access for development
    }
  }
}